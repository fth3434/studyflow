let currentLang = localStorage.getItem("lang") || "tr";

function getText(key) {
    return dict[currentLang] && dict[currentLang][key] ? dict[currentLang][key] : key;
}

function changeLanguage(lang) {
    currentLang = lang;
    localStorage.setItem("lang", lang);
    const sel = document.getElementById("langSelect");
    if(sel) sel.value = lang;
    
    document.querySelectorAll("[data-lang]").forEach(el => {
        const key = el.getAttribute("data-lang");
        if(dict[lang][key]) {
            el.innerText = dict[lang][key];
        }
    });

    document.querySelectorAll("[data-lang-placeholder]").forEach(el => {
        const key = el.getAttribute("data-lang-placeholder");
        if(dict[lang][key]) {
            el.placeholder = dict[lang][key];
        }
    });

    // Re-render dynamic parts
    loadUser();
    if(chart) renderChart(dashboardData.completedTasks, dashboardData.pendingTasks);
    updateCalculatorUI();
    loadExams();
    loadStudySessions();
    loadCourses();
    changeQuote();
    
    // Update education levels manually since they are <option>
    const edLvl = document.getElementById("educationLevel");
    if(edLvl && edLvl.options.length > 1) {
        edLvl.options[0].text = getText('gpa_uni');
        edLvl.options[1].text = getText('gpa_highschool');
    }
}

document.addEventListener("DOMContentLoaded", () => {
    changeLanguage(currentLang);
});